# Database — SQLite for local dev, Postgres for production
# SQLite:    DATABASE_URL=file:./dev.sqlite
# Postgres:  DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=file:./dev.sqlite

# Express server port
PORT=4000

# Phase 1 admin guard — required header `x-admin-token` on /api/admin/*
# Replace with real auth in Phase 6.
ADMIN_TOKEN=dev-token

# CORS origin for the Vite dev server
WEB_ORIGIN=http://localhost:5173

NODE_ENV=development
